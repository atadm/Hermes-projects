    {
      "name": "Legend & Guide",
      "column_widths": {"A": 30, "B": 80},
      "rows": [
        [{"value": "RAID definitions", "bold": true, "font_size": 13}],
        [{"value": "R — Risk", "wrap": true}, {"value": "Something that may happen in the future and hurt the project. Has probability + impact. Manage with mitigation.", "wrap": true}],
        [{"value": "A — Assumption", "wrap": true}, {"value": "Something believed to be true without proof. Validate it — an invalid assumption becomes a risk or issue.", "wrap": true}],
        [{"value": "I — Issue", "wrap": true}, {"value": "Something that has already happened and needs action now. Owner + target date required.", "wrap": true}],
        [{"value": "D — Dependency", "wrap": true}, {"value": "Something the project depends on (another team, vendor, system, decision). Track owner and date.", "wrap": true}],
        [{"value": ""}],
        [{"value": "Exposure scoring", "bold": true, "font_size": 13}],
        [{"value": "Exposure", "wrap": true}, {"value": "= Impact × Probability (for risks only; leave blank for A/I/D). 1–25 scale. ≥12 = red, <6 = green, otherwise yellow.", "wrap": true}],
        [{"value": ""}],
        [{"value": "Cadence & rules", "bold": true, "font_size": 13}],
        [{"value": "Update weekly", "wrap": true}, {"value": "EPO reviews the log weekly; top 3 risks/issues feed the steering 1-pager monthly.", "wrap": true}],
        [{"value": "Status transitions", "wrap": true}, {"value": "Open → Mitigating/Monitoring → Resolved (or Closed). Never delete rows — history matters.", "wrap": true}],
        [{"value": "Decisions", "wrap": true}, {"value": "When a RAID item triggers a decision, record it in the Decision Log.", "wrap": true}],
        [{"value": "Ownership", "wrap": true}, {"value": "Every item has exactly one owner. No owner = item not tracked.", "wrap": true}]
      ]
    }
