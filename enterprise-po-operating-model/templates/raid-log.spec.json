      "validations": [
        {"range": "A5:A14", "type": "list", "formula1": "\"R,A,I,D\""},
        {"range": "F5:F14", "type": "list", "formula1": "\"Open,Mitigating,Monitoring,Resolved,Closed\""},
        {"range": "G5:G14", "type": "list", "formula1": "\"Red,Yellow,Green\""}
      ],
      "conditional_formats": [
        {"range": "G5:G14", "type": "cell_is", "operator": "equal", "formula": ["\"Red\""], "fill": "FFC7CE"},
        {"range": "G5:G14", "type": "cell_is", "operator": "equal", "formula": ["\"Yellow\""], "fill": "FFEB9C"},
        {"range": "G5:G14", "type": "cell_is", "operator": "equal", "formula": ["\"Green\""], "fill": "C6EFCE"},
        {"range": "J5:J14", "type": "cell_is", "operator": "greaterThanOrEqual", "formula": ["12"], "fill": "FFC7CE"},
        {"range": "J5:J14", "type": "cell_is", "operator": "lessThan", "formula": ["6"], "fill": "C6EFCE"}
      ]
