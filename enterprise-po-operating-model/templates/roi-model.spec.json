        [{"value": "CALCULATIONS (derivation — do not edit)", "bold": true, "fill": "F2F2F2"}, null, null, null, null, null],
        [{"value": "Annual hours today", "align": "left"}, {"formula": "=B17*B18/60*B19*B20", "format": "#,##0"}, null, null, null, null],
        [{"value": "FTE equivalent today", "align": "left"}, {"formula": "=B32/B25", "format": "0.0"}, null, null, null, null],
