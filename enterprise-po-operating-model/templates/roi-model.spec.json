        [{"value": "Hours per FTE per year", "align": "left"}, {"value": 2080, "fill": "FFF2CC", "format": "#,##0"}, {"value": "h"}, {"value": "Used for FTE conversion and hourly rate", "italic": true, "font_color": "808080"}, null, null],
