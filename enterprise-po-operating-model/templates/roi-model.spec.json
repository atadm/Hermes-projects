        [{"value": "Ongoing annual operating cost", "align": "left"}, {"value": 5000, "fill": "FFF2CC", "format": "$#,##0"}, {"value": "$/yr"}, {"value": "Licenses, support, platform usage per year", "italic": true, "font_color": "808080"}, null, null],
        [{"value": "Additional annual hard savings", "align": "left"}, {"value": 0, "fill": "FFF2CC", "format": "$#,##0"}, {"value": "$/yr"}, {"value": "Quantifiable extras: error reduction, penalties avoided, materials, capacity to avoid new hires", "italic": true, "font_color": "808080"}, null, null],
        [null],
