        [{"value": "Steady-state adoption rate", "align": "left"}, {"value": 0.8, "fill": "FFF2CC", "format": "0%"}, {"value": "%"}, {"value": "Share of target users actually using the automation at steady state (0–1)", "italic": true, "font_color": "808080"}, null, null],
