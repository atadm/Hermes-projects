        [{"value": "Year-1 ramp factor", "align": "left"}, {"formula": "=MAX(0,(12-B23/2)/12)", "format": "0%"}, null, {"value": "Linear ramp from 0 to full benefit over B23 months; avg benefit in the first 12 months", "italic": true, "font_color": "808080"}, null, null],
        [{"value": "Steady-state hours saved", "align": "left"}, {"formula": "=B32*B21*B22", "format": "#,##0"}, null, null, null, null],
        [{"value": "Steady-state annual savings", "align": "left"}, {"formula": "=B36*B34+B28", "format": "$#,##0"}, null, null, null, null],
        [{"value": "Net annual benefit", "align": "left"}, {"formula": "=B37-B27", "format": "$#,##0"}, null, null, null, null],
