        [{"value": "Working weeks per year", "align": "left"}, {"value": 52, "fill": "FFF2CC", "format": "#,##0"}, {"value": "weeks"}, {"value": "52 × 40 h = 2,080 h/yr convention; lower if your org uses a different basis", "italic": true, "font_color": "808080"}, null, null],
